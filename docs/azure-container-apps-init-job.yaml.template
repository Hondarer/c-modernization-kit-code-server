# Azure Container Apps init Job テンプレート
#
# home/workspace の初期化 (既定設定・拡張機能の導入) だけを行う一度きりのJob。
# Azure Files上での拡張機能再展開はローカルディスクより大幅に遅く、Container Apps
# の既定startup probe猶予を超えることがあるため、ingress・startup probe付きの
# 本Appを起動する前に、このJobで初期化を完了させておく (aca-instance.sh の
# create/reset から呼び出す)。
#
# docs/azure-container-apps-publish.md の手順で各プレースホルダーを置換してから
# az containerapp job create/update --yaml へ渡す。Secretの値は含めない。
identity:
  type: UserAssigned
  userAssignedIdentities:
    __IDENTITY_ID__: {}
location: __LOCATION__
name: __JOB_NAME__
resourceGroup: __RESOURCE_GROUP__
type: Microsoft.App/jobs
tags:
  application: code-server
  environment: production
  managed-by: aca-instance.sh
properties:
  environmentId: __ENVIRONMENT_ID__
  configuration:
    triggerType: Manual
    replicaTimeout: 1800
    replicaRetryLimit: 0
    replicaCompletionCount: 1
    parallelism: 1
    registries:
      - identity: __IDENTITY_ID__
        server: __ACR_LOGIN_SERVER__
    secrets:
      - name: code-server-password
  template:
    containers:
      - name: __JOB_NAME__
        image: __REMOTE_IMAGE__
        command:
          - /usr/local/bin/code-server-init-home.sh
        env:
          - name: HOST_USER
            value: user
          - name: HOST_UID
            value: "1000"
          - name: HOST_GID
            value: "1000"
          - name: PASSWORD
            secretRef: code-server-password
        resources:
          cpu: 1.0
          memory: 2Gi
        volumeMounts:
          - volumeName: code-data
            mountPath: /home/user
            subPath: home
          - volumeName: code-data
            mountPath: /workspace
            subPath: workspace
    volumes:
      - name: code-data
        storageType: AzureFile
        storageName: __ENV_STORAGE_NAME__
        mountOptions: uid=1000,gid=1000,dir_mode=0755,file_mode=0755,mfsymlinks,cache=strict,nosharesock,serverino
