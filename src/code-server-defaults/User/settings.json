{
    // ワークスペース信頼確認を無効化する
    "security.workspace.trust.enabled": false,
    // 初回起動時のカラーテーマに C/C++ 向け Visual Studio Dark を使用する
    "workbench.colorTheme": "Visual Studio Dark - C++",
    // フォントを UDEV Gothic HSRFJPDOCEM 15px にする
    "editor.fontFamily": "'UDEV Gothic HSRFJPDOCEM'",
    "editor.fontSize": 15,
    // git の自動フェッチを有効にする
    "git.autofetch": true,
    // エディタ上ですべての空白文字を可視化する
    "editor.renderWhitespace": "all",
    // diff で行末空白の違いを無視せず、変更として表示する
    "diffEditor.ignoreTrimWhitespace": false,
    // Markdown Preview Enhanced が使用する PlantUML JAR のパスを指定する
    "markdown-preview-enhanced.plantumlJarPath": "${env:PLANTUML_HOME}/plantuml.jar",
}
